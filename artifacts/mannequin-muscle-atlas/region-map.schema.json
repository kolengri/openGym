{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengym.local/schemas/illustrative-muscle-region-map.schema.json",
  "title": "Illustrative mannequin muscle region map",
  "type": "object",
  "required": ["version", "notice", "body", "catalogue", "regions", "mappings", "sources"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "notice": { "type": "string", "minLength": 1 },
    "body": {
      "type": "object",
      "required": ["name", "source", "base_vertices", "base_polygons", "rest_sha256", "units", "height", "front", "left"],
      "properties": {
        "name": { "type": "string" }, "source": { "type": "string" },
        "base_vertices": { "const": 10582 }, "base_polygons": { "const": 10590 },
        "rest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "units": { "const": "m" }, "height": { "const": 1.8 },
        "front": { "const": "-Y" }, "left": { "const": "+X" }
      }
    },
    "catalogue": {
      "type": "object",
      "required": ["canonical_records", "distinct_names", "alias_stubs", "fields"],
      "properties": {
        "canonical_records": { "type": "integer", "minimum": 1 },
        "distinct_names": { "type": "integer", "minimum": 1 },
        "alias_stubs": { "type": "integer", "minimum": 0 },
        "fields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "regions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9_]+\\.[LR]$" },
      "additionalProperties": {
        "type": "object",
        "required": ["label", "side", "group", "visibility", "fiber_direction", "weighted_vertices", "core_vertices", "max_weight"],
        "properties": {
          "label": { "type": "string" }, "side": { "enum": ["L", "R"] },
          "group": { "type": "string" },
          "visibility": { "enum": ["superficial", "partial_surface", "deep_projection"] },
          "fiber_direction": { "type": "string" },
          "weighted_vertices": { "type": "integer", "minimum": 1 },
          "core_vertices": { "type": "integer", "minimum": 0 },
          "max_weight": { "type": "number", "minimum": 0.1, "maximum": 1 }
        }
      }
    },
    "mappings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "regions", "reason"],
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["surface", "partial_surface", "group_proxy", "deep_projection", "systemic", "unsupported"] },
          "regions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "reason": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          { "if": { "properties": { "status": { "enum": ["systemic", "unsupported"] } } },
            "then": { "properties": { "regions": { "maxItems": 0 } } },
            "else": { "properties": { "regions": { "minItems": 1 } } } }
        ]
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["title", "url", "use"],
        "properties": { "title": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "use": { "type": "string" } } }
    }
  }
}
